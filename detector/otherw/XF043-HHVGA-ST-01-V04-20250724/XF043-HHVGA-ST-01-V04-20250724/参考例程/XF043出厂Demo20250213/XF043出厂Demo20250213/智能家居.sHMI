            <EventContent EventContent="EventContent">
                <EventStatus0>0</EventStatus0>
                <EventText0></EventText0>
                <EventStatus1>1</EventStatus1>
                <EventText1>input=user.get_text(12)
last=user.get_svar(0)
if(len(input)&lt;15):
 if '.'in input:# 已经输入过小数点
  if '*'in input:
   if last not in("/","+","-","*"):
    user.set_text(12,input+'.')
    user.set_svar(0,".")
  if '/'in input:
   if last not in("/","+","-","*"):
    user.set_text(12,input+'.')
    user.set_svar(0,".")
  if '+'in input:
   if last not in("/","+","-","*"):
    user.set_text(12,input+'.')
    user.set_svar(0,".")
  if '-'in input:
   if last not in("/","+","-","*"):
    user.set_text(12,input+'.')
    user.set_svar(0,".")
 else :
  if last not in("/","+","-","*"):	
   user.set_text(12,input+'.')
   user.set_svar(0,".")</EventText1>
                <EventStatus2>0</EventStatus2>
                <EventText2></EventText2>
                <EventStatus3>0</EventStatus3>
                <EventText3></EventText3>
                <EventStatus4>0</EventStatus4>
                <EventText4></EventText4>
            </EventContent>
