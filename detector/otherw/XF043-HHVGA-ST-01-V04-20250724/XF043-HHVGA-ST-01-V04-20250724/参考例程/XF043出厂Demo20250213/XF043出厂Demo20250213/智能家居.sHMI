            <EventText0>page=user.get_page()
a=user.get_ivar(1)
if page ==17:
 r1=user.get_val(8)
 r2=user.get_val(9)
 r3=user.get_val(10)
 r4=user.get_val(11)
 user.set_val(1,a)
 #user.set_text(2,'0')
 user.set_ivar(1,a+40)
 user.set_text(2,str(user.get_val(1)+30))
 user.set_hidden(5,0,0)
 user.set_hidden(6,0,0)
 user.set_hidden(7,0,0)
 user.set_hidden(11,0,0)
 user.set_hidden(13,0,0)
 user.set_hidden(15,0,0)
 if a>100 :
  user.set_ivar(1,0)
 if r1==221:
  user.set_val(8,222)
 elif r1==222:
  user.set_val(8,221)
 if r2==233:
