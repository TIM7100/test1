            <EventText0>import urandom
page=user.get_page()
#v=user.get_ivar(29)
if page ==18:
 #user.set_ivar(29,v+1) 
 user.set_ct_val(1,0,0,urandom.randint(0,50),1)
 user.set_ct_val(1,0,1,urandom.randint(0,50),1)
 user.set_ct_val(1,0,2,urandom.randint(0,50),1)
 user.set_ct_val(1,0,3,urandom.randint(0,50),1)
 user.set_ct_val(1,0,4,urandom.randint(0,50),1)
 user.set_ct_val(1,0,5,urandom.randint(0,50),1)
 user.set_ct_val(1,0,6,urandom.randint(0,50),1)
 user.set_ct_val(1,0,7,urandom.randint(0,50),1)
 user.set_ct_val(1,0,8,urandom.randint(0,50),1)
 user.set_ct_val(1,0,9,urandom.randint(0,50),1)
 user.set_ct_val(1,0,10,urandom.randint(0,50),1)
 user.set_ct_val(1,0,11,urandom.randint(0,50),1)
 user.set_ct_val(1,0,12,urandom.randint(0,50),1)
