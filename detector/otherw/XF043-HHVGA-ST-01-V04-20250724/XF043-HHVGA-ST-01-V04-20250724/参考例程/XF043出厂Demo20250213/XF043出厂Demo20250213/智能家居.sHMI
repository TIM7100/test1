 user.set_text(37,"厂家信息")

elif status %2 ==0:
 user.set_text(36,"英文")
 #user.set_height(16,60)# 高度变大容纳2行
 user.set_width(16,100)
 user.set_x(16,8)
 user.set_text(16,"SmartHome")
 user.set_text(17,"Chart")
 user.set_text(18,"Calculator")
 user.set_height(19,60)# 高度变大容纳2行
 #user.set_width(19,120)
 #user.set_x(19,355)
