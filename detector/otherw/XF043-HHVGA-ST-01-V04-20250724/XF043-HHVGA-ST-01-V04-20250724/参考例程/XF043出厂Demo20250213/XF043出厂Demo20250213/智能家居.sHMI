                <EventText1>flag=user.get_ivar(0)
if (flag==0) :#尚视界提示条缩回去
# id_start_end_time_mode
 user.set_anim_hdir(1,-10,-500,30,5)#尚视界
 user.set_anim_hdir(4,0,-280,30,5) #致力
 user.set_anim_hdir(6,0,-295,30,5)#自主开发
 user.set_hidden(7,0,0)#上排按钮1
 user.set_hidden(8,0,0)#上排按钮2
 user.set_hidden(9,0,0)#上排按钮3
 user.set_hidden(10,0,0)#上排按钮4

 user.set_hidden(11,0,0)#下排按钮1
 user.set_hidden(12,0,0)#下排按钮2
 user.set_hidden(13,0,0)#下排按钮3
 user.set_hidden(14,0,0)#下排按钮4
 
 user.set_hidden(16,0,0)#智能家居字符
 user.set_hidden(17,0,0)#图库字符
 user.set_hidden(18,0,0)#计算器字符
 user.set_hidden(19,0,0)#饮水机字符

 user.set_hidden(20,0,0)#二维码字符
 user.set_hidden(21,0,0)#进度条字符
 user.set_hidden(22,0,0)#设置字符
 user.set_hidden(23,0,0)#文本字符 
# id_start_end_time_mode

 user.set_anim_vdir(7,-200,30,300,5)#智能家居
 user.set_anim_vdir(8,-200,30,300,5)#图库
 user.set_anim_vdir(9,-200,30,300,5)#计算器
 user.set_anim_vdir(10,-200,30,300,5)#饮水机

 user.set_anim_vdir(11,360,160,300,5)#二维码
 user.set_anim_vdir(12,360,160,300,5)#进度条
 user.set_anim_vdir(13,360,160,300,5)#设置
 user.set_anim_vdir(14,360,160,300,5)#文本

 user.set_anim_vdir(16,-100,108,50,5)#智能家居字符
 user.set_anim_vdir(17,-100,108,50,5)#图库字符
 user.set_anim_vdir(18,-100,108,50,5)#计算器字符
 user.set_anim_vdir(19,-100,108,50,5)#饮水机字符

 user.set_anim_vdir(20,320,236,50,5)#二维码字符
 user.set_anim_vdir(21,320,236,50,5)#进度条字符
 user.set_anim_vdir(22,320,236,50,5)#设置字符
 user.set_anim_vdir(23,320,236,50,5)#文本字符
 user.set_ivar(0,1)
 #设置电池图标的显示
 user.set_hidden(24,0,0)
 user.set_hidden(25,0,0)
 user.set_hidden(26,0,0)

elif (flag==1) :#这个条件就执行不，完全缩进去了
 user.set_anim_hdir(1,-463,-10,10,5)#尚视界
 user.set_anim_hdir(4,-280,0,10,5) #致力
 user.set_anim_hdir(6,-295,0,10,5)#自主开发
 user.set_hidden(7,0,1)
 user.set_hidden(8,0,1)
 user.set_hidden(9,0,1)
 user.set_hidden(10,0,1)

 user.set_hidden(11,0,1)
 user.set_hidden(12,0,1)
 user.set_hidden(13,0,1)
 user.set_hidden(14,0,1)


 user.set_hidden(16,0,1)
