                <EventText1>input=user.get_text(12)# 获取输出框中的字符
if(len(input)&lt;15):#判定满了没有
 if '*'in input:# 乘法
  str_out=input.split('*')
  if '.'in str_out[0]:
   one_data=float(str_out[0])
  else :
   one_data=int(str_out[0])
  if '.'in str_out[1]:
   two_data=float(str_out[1])
   result=str(one_data*two_data)
   
  else :
   two_data=int(str_out[1])
   result=str(one_data*two_data)
  if len(result)&lt;15:
   user.set_text(12,result)
   user.set_text(26,result)
  else :
    user.set_text(12,"超出显示位数")
 if '/'in input:# 除法
  str_out=input.split('/')
  if '.'in str_out[0]:
   one_data=float(str_out[0])
  else :
   one_data=int(str_out[0])
  if '.'in str_out[1]:
   two_data=float(str_out[1])
   result=str(one_data/two_data)
   #user.set_text(12,result)
  else :
   two_data=int(str_out[1])
   result=str(one_data/two_data)
   #user.set_text(12,result)
  if len(result)&lt;15:
   user.set_text(12,result)
   user.set_text(26,result)
  else :
    user.set_text(12,"超出显示位数")
 if '+'in input:# 加法
  str_out=input.split('+')
  if '.'in str_out[0]:
   one_data=float(str_out[0])
  else :
   one_data=int(str_out[0])
  if '.'in str_out[1]:
   two_data=float(str_out[1])
   result=str(one_data+two_data)
   #user.set_text(12,result)
  else :
   two_data=int(str_out[1])
   result=str(one_data+two_data)
   #user.set_text(12,result)
  if len(result)&lt;15:
   user.set_text(12,result)
   user.set_text(26,result)
  else :
    user.set_text(12,"超出显示位数")
 if '-'in input:# 减法
  str_out=input.split('-')
  if '.'in str_out[0]:
   one_data=float(str_out[0])
  else :
   one_data=int(str_out[0])
  if '.'in str_out[1]:
   two_data=float(str_out[1])
   result=str(one_data-two_data)
   #user.set_text(12,result)
  else :
   two_data=int(str_out[1])
   result=str(one_data-two_data)
   #user.set_text(12,result)
  if len(result)&lt;15:
   user.set_text(12,result)
   user.set_text(26,result)
  else :
    user.set_text(12,"超出显示位数")
