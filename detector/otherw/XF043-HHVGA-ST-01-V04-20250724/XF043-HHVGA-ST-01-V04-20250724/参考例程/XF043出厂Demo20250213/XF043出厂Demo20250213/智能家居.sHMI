 user.set_text(23,"Text")
 user.set_text(34,"BL Setting")
 user.set_text(35,"Buzzer")
 user.set_text(36,"Language")
 user.set_text(37,"Info")
user.set_ivar(3,status+1)#将按键的状态保存
