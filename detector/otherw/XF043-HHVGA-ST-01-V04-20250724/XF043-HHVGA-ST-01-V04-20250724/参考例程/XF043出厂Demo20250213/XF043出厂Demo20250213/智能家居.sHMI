                <EventText1>status=user.get_ivar(3) # 获取状态
#print(status)
if status %2 ==1 :
 user.set_text(36,"中文")
 #user.set_height(16,30)# 高度变大容纳2行
 user.set_width(16,80)
 user.set_x(16,12)
 user.set_text(16,"智能家居")
