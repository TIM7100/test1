 user.set_hidden(19,0,1)

 user.set_hidden(20,0,1)
 user.set_hidden(21,0,1)
 user.set_hidden(22,0,1)
 user.set_hidden(23,0,1)
 user.set_ivar(0,0)</EventText1>
