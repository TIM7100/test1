                <EventStatus1>1</EventStatus1>
                <EventText1>input=user.get_text(12)# 获取输出框中的字符
last=user.get_svar(0)
if(len(input)&lt;15):#判定满了没有
 if '+'in input:# 已经输入过/
  user.set_text(12,input)
 else :
  if last not in(".","/","-","*"):
   if ('-' not in input) and ('*' not in input) and ('/' not in input):
    user.set_text(12,input+'+')
    user.set_svar(0,"+")</EventText1>
                <EventStatus2>0</EventStatus2>
