                <EventText1>status=user.get_val(5)
if status %3 ==0 :
 user.set_text(5,"全关")
 user.set_bg_color(5,0,3220126)
 user.set_text(35,"窗帘已经全关")
elif status %3== 1:
 user.set_text(5,"半开")
 user.set_bg_color(5,0,65535)
 user.set_text(35,"窗帘已经半开")
elif status %3 == 2:
 user.set_text(5,"全开")
 user.set_bg_color(5,0,255)
 user.set_text(35,"窗帘已经全开")
</EventText1>
