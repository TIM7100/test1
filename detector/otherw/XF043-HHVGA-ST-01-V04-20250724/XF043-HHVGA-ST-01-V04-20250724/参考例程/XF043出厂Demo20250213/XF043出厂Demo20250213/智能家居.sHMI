                <EventStatus1>1</EventStatus1>
                <EventText1>status=user.get_val(33)
if status %3 == 0 :
 user.set_text(33,"自动")
 user.set_bg_color(33,0,3220126)
 user.set_text(35,"蓄电池自动状态已打开")
elif status %3 == 1:
 user.set_text(33,"开启")
 user.set_bg_color(33,0,11206400)
 user.set_text(35,"蓄电池已开启")
elif status %3 == 2:
 user.set_text(33,"关闭")
 user.set_bg_color(33,0,112064)
 user.set_text(35,"蓄电池已关闭")</EventText1>
