#define PACKET_TRY_COUNT	5				     //5s, 发送报文失败时，尝试的次数
#define WAIT_RX_PACKET_TIME 10				     //单位 500ms，等待云平台报文时间，等待时间到后，发送一次心跳报文
#define KEEP_ALIVE_COUNT	10 			         //发送周期 WAIT_RX_PACKET_TIME * 200 ms;当发送 KEEP_ALIVE_COUNT次 心跳报文后，还没接收到数据，代表云平台没有下发数据


MQTT_PACKET_INFOR MqttPacket;

