#ifndef __IAP_H__
#define __IAP_H__

#include "ach512.h"
#include  "uart.h"
#include "EfcApp.h"
#include "usart_lcd.h"
#include "XxyData.h"
#include "XxyCrc.h"
#include "AesApp.h"
#include "ShowInfo.h"

//固件升级错误
#define STATUS_TRUE                         0x00
#define IAP_REV_FAIL                        0x01
#define EFLASH_FLAG_FAIL                    0x02
#define VERSION_INFO_FAIL                   0x03
#define AES_CRYPT_FAIL                      0x04
#define UPDATE_NALLOW_FAIL                  0x05

//程序跳转错误
#define RUN_APP_FAIL                        0x11

//等待IAP数据
#define WAIT_IAP_DATA                       0xA0

//信息区大小(固定)
#define INFO_AREA_LEN                       153

typedef struct                              //上位机传输信息
{
    u8 TKE[16];                             //通信密钥，三级密钥
    u8 ChipID[6];                           //固件芯片ID
    u8 EditionDate[10];											//固件程序日期
    u8 ReservedArea[112];										//预留区域
    u8 HEXKey[16];													//HEX密钥，一级密钥
} RevInfo;

typedef struct                              //芯片内部存储信息
{
    u8 FixedKey[10][8];											//固定密钥
    u8 ChipID[6];														//EFlash芯片ID
    u8 EditionDate[10];											//EFlash程序日期
    u8 InfoKey[16];													//信息区密钥，二级密钥
} EflashInfo;

typedef  void (*iapfun)(void);              //定义一个函数类型的参数.

//提取芯片内部存储信息
u8 ExtractEflashInfo(EflashInfo ChipInfo);

//提取上位机传输信息
u8 ExtractRevInfo(RevInfo IapInfo, u8* RecData, u16 RecLen, EflashInfo ChipInfo);

u8 IapWriteAppBin(u8* BinData, u16 BinLen, RevInfo IapInfo, EflashInfo ChipInfo);

u8 CompareVersionInfo(RevInfo IapInfo, EflashInfo ChipInfo);

void IapStatusRespond(u8 Status);

u8 DiscernVersionInfo(u8* VersionInfo);

u8 IapDataProcess(u8* Data, u16 DataLen);

void FirmwareUpdate(void);

void IapLoadApp(u32 Addr);

//设置堆栈地址
void MSR_MSP(u32 addr);

#endif
