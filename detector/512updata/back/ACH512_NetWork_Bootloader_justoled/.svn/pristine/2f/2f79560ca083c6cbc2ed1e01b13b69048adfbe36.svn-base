#ifdef UART_DEBUG_ENABLE
void PrintfHex(u8 *RxBuff, u16 Len)
{
	u16 i;
	for (i = 1; i <= Len; i++)
	{
		printfS("%02X ", RxBuff[i - 1]);
		if (i % 16 == 0)
		{
			printfS("\r\n");
		}		
	}
    printfS("\r\n");
}

void PrintfString(const char *Buff, u16 Len)
{
	u16 i;
	for (i = 0; i < Len; i++)
	{
		printfS("%c", Buff[i]);
	}
	printfS("\r\n");
}

void PrintfDecs(u8 *Buff, u16 Len)
{
	u16 i;
	for (i = 0; i < Len; i++)
	{
		printfS("%d.", Buff[i]);
	}
	printfS("\r\n");
}


