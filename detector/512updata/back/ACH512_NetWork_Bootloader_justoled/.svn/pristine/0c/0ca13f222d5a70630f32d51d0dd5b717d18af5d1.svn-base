void GetOTAInfoShow(u8 Result)
{
	char ErrCode[15] = {0};

	ClearShow();
	sprintf(ErrCode, "Error Code %d", Result);

	if (DeviceLanguageFlag == EN)
	{
		LCD_UartSend("DC16(18,50,'Get Firmware Err',1);\r\n");
		LCD_UartSend(CMD_DC16(30, 68, (u8*)ErrCode, 1));
	}
	else
	{
		LCD_UartSend("DC16(18,50,'获取固件信息失败',1);\r\n");
		LCD_UartSend(CMD_DC16(30, 68, (u8*)ErrCode, 1));
	}
}

