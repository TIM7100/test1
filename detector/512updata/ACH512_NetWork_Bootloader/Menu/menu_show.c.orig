void Ethernet_Action(void)//网口插入动作
{
    char Ethernet_buf[32];
    int i;

    for (i = 0; i < 25; i += 5)
    {
        sprintf(Ethernet_buf, "SBC(0);DC24(310,%d,'↓',2);\r\n", 30 + i);
        LCD_UartSend(Ethernet_buf);
        Timer0DelayMs(10);
    }

    if (DeviceLanguageFlag == EN)
    {
        LCD_UartSend("DC24(354,20,'Net',2);\r\n");
    }
    else
    {
        LCD_UartSend("DC24(334,20,'网口',2);\r\n");
    }
}
