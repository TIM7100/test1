/*-------------------------------------------------*/
/*函数名：WiFi发送设置指令                         */
/*参  数：cmd：指令                                */
/*参  数：timeout：超时时间（100ms的倍数）         */
/*返回值：0：正确   其他：错误                     */
/*-------------------------------------------------*/
static uint8_t WiFi_SendCmd(uint8_t *cmd, int16_t timeout)
{
// 	 u8 tmp[64];
//     int n = 0;
    uint8_t   Rx_Buffer[2048];
    uint16_t  Rx_Buffer_Index = 0;
    int rbCanReadLen;

    memset(Rx_Buffer, 0, 2048);
    WiFi_printf("%s\r\n", cmd);  
	
   
//     while (cmd[n]) { tmp[n] = cmd[n]; n++; }   
//     tmp[n++] = 0x0D;                           
//     tmp[n++] = 0x0A;                           
//     uart_send_bytes(UARTB, tmp, n);


#ifdef DEBUG_ESP
    printf("%s\r\n", cmd);
#endif
    while (timeout--)                                   //等待超时时间到0
    {
        Timer0DelayMs(10);                                   //延时10ms

        //获取网络芯片返回的数据个数
        rbCanReadLen = rbCanRead(&rb_t_ssl);
        //有缓存的数据
        if (rbCanReadLen > 0)
        {
            //只返回当前有的
            rbRead(&rb_t_ssl, &Rx_Buffer[Rx_Buffer_Index], rbCanReadLen);
            Rx_Buffer_Index += rbCanReadLen;

            if (strstr((char *)Rx_Buffer, "OK"))          //如果接收到OK表示指令成功

            {
                //打印信息
#ifdef DEBUG_ESP
                for (uint32_t i = 0; i < Rx_Buffer_Index; i++)
                {
                    UART_SendData(UART1, Rx_Buffer[i]);
                }
#endif
                break;                                      //主动跳出while循环
            }
        }

    }
    if (timeout <= 0)
    {
        return 1;                                       //如果timeout<=0，说明超时时间到了，也没能收到OK，返回1
    }
    else
    {
        return 0;                                       //反之，表示正确，说明收到OK，通过break主动跳出while
    }
}

