// #define WiFi_printf(fmt, ...)  UART_printf(UARTB, fmt, ##__VA_ARGS__)
#define WiFi_printf(fmt, ...)  do { \
    char _wp_buf[256]; \
    int  _wp_len = sprintf(_wp_buf, fmt, ##__VA_ARGS__); \
    if (_wp_len > 0) uart_send_bytes(UARTB, (u8*)_wp_buf, (u32)_wp_len); \
} while(0)
#define WIFI_SET_RST_IO     REG_GPIO_SET(GPIOA) |= 0x4000000;
#define WIFI_RESET_RST_IO   REG_GPIO_CLR(GPIOA) |= 0x4000000;

extern char account[32]; // 存放用户名文本
extern char password[32]; // 存放用户名密码

WifiInfo_t Wifi_Info = 
{
	"XXY",
	"goodeveryday",
	SmartConfig_Uncompleted
};

void Get_WifiInfo(void)
{
	EflashReadPage(WIFI_SSID_Addr, 36, (uint32_t *)Wifi_Info.SSID);
	EflashReadPage(WIFI_Password_Addr, 36, (uint32_t *)Wifi_Info.Password);
}




void WiFi_IO_Init(void)
{
    REG_SCU_MUXCTRLB &= ~(0x300000);
    REG_GPIO_DIR(GPIOA) |= 0x4000000;
}

/*-------------------------------------------------*/
/*函数名：初始化WiFi的复位IO                       */
/*参  数：无                                       */
/*返回值：无                                       */
/*-------------------------------------------------*/

void WiFi_Init(void)
{
   
	  WiFi_IO_Init();
    WIFI_RESET_RST_IO;                                //复位IO拉低电平
    Timer0DelayMs(50)  ;                        //延时，至少200us以上低电平
    WIFI_SET_RST_IO;                                  //复位IO拉高电平
    Timer0DelayMs(1500)  ; 
	
// 	 Get_WifiInfo();
}

