            <EventText0>if(user.get_page()==10):#饮水机demo
  r1=user.get_val(1)
  r2=user.get_val(2)
  r3=user.get_val(3)
  

  if r1== 126:
   user.set_val(1,123)
   user.set_text(8,"88")
   user.set_text(9,"88")
 
  elif r1== 123:
   user.set_val(1,126)
   user.set_text(8,"66")
   user.set_text(9,"66")

  if r2== 125:
   user.set_val(2,124)
  elif r2== 124:
   user.set_val(2,125)
  if r3== 121:
   user.set_val(3,122)
  elif r3== 122:
   user.set_val(3,121)
elif(user.get_page()==3):#欢迎界面
 if user.get_ivar(2) ==0:#获取闪烁的标志
  user.set_ivar(2,1)
  if user.get_ivar(0) == 1:#是菜单了
   user.set_opa(10,0,125) 
  elif user.get_ivar(0) == 0:#是欢迎界面
   user.set_font_color(1,13158600)
 elif user.get_ivar(2) ==1:
  user.set_ivar(2,0)
  if user.get_ivar(0) == 1:#是菜单了
   user.set_opa(10,0,255) 
  elif user.get_ivar(0) == 0:#是欢迎界面
   user.set_font_color(1,16777215)

