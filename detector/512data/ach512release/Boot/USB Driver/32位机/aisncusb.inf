;
; File Name: aisncusb.inf
; Install information file for aisncusb Driver
; File created on 9/14/2007
;

;--------- Version Section ---------------------------------------------------

[Version]
Signature="$CHICAGO$"
Class=USB
ClassGUID={36FC9E60-C465-11CF-8056-444553540000}
Provider=%Provider%
DriverVer=09/14/2007,2.00.0000
CatalogFile=aisncusb.cat


;--------- DestinationDirs Section -------------------------------------------

[DestinationDirs]
;DefaultDestDir = 10,System32\Drivers
AISNCUSB_Files_Driver = 12


;--------- SourceDiskNames and SourceDiskFiles Section -----------------------
; These sections identify source disks and files for installation.

[SourceDisksNames]
1 = %DiskId1%,,,""

[SourceDisksFiles]
aisncusb.sys  = 1,,


;--------- Manufacturer and Models Sections ----------------------------------

[Manufacturer]
%MfgName% = AisinoChip_Mfg

[AisinoChip_Mfg]
; DisplayName               Section           DeviceId
%AISNCUSB_DeviceDesc%=AISNCUSB_DDI, USB\VID_1234&PID_ABCD

;---------- DDInstall Sections -----------------------------------------------

;[AISNCUSB_DDI]
;CopyFiles=AISNCUSB_Files_Driver
;AddReg=AISNCUSB_AddReg

[AISNCUSB_DDI.NT]
CopyFiles=AISNCUSB_Files_Driver
AddReg=AISNCUSB_AddReg

[AISNCUSB_AddReg]
HKR,,DevLoader,,*ntkern
HKR,,NTMPDriver,,aisncusb.sys
HKR,,Description,,%AISNCUSB_DeviceDesc%

[AISNCUSB_DDI.NT.Services]
Addservice = AISNCUSB, 0x00000002, AISNCUSB_Service

; --------- Service ----------------------

[AISNCUSB_Service]
DisplayName    = %AISNCUSB_SvcDesc%
ServiceType    = 1					;SERVICE_KERNEL_DRIVER
StartType      = 3					;SERVICE_DEMAND_START
ErrorControl   = 1					;SERVICE_ERROR_NORMAL
ServiceBinary  = %12%\aisncusb.sys
LoadOrderGroup = Extended Base

; --------- Files ----------------------

[AISNCUSB_Files_Driver]
aisncusb.sys,,,2

;--------- Strings Section ---------------------------------------------------

[Strings]
Provider = "AisinoChip"
MfgName = "AisinoChip"
AISNCUSB_DeviceDesc = "AisinoChip USB"
AISNCUSB_SvcDesc = "Driver for AisinoChip USB"
DiskId1 = "Aisncusb Device Installation Disk #1"