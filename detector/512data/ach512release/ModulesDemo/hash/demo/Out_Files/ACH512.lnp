--cpu Cortex-M3
".\out_files\startup.o"
".\out_files\system_ach512.o"
".\out_files\uart.o"
".\ACH512\driver\sha1_20170308.lib"
".\ACH512\driver\sha256_20170308.lib"
".\ACH512\driver\sha384_20170308.lib"
".\ACH512\driver\sm3_20170308.lib"
