/*---------------------------------------------------------------------------------------------------------*/
/* Function:     basicUserInterface                                                                        */
/*                                                                                                         */
/* Parameter:                                                                                              */
/*               None                                                                                      */
/* Returns:                                                                                                */
/*               None                                                                                      */
/* Description:                                                                                            */
/*               基础用户界面                                                                              */
/*---------------------------------------------------------------------------------------------------------*/
void UserFunctionInterface(void)
{
    u8 AreaCodeSel;
    u16 KeyPressed;

    Confirm_Selection(MenuPoint[UserChoose].DisplayString);

    while (1)  /*  基础用户界面循环,只接受Enter键(执行命令)和Esc键(返回父目录) */
    {
        KeyPressed = 0x0000;
        KeyPressed = AutoKeyScan();

        if (KeyPressed == Key_Enter)             /* 执行对应命令 */
        {
            AreaCodeSel = MenuPoint[UserChoose].AreaCode; //烧录区域
//                      VolumeSortSel   =   MenuPoint[UserChoose].VolumeSort;//打印容量

            switch (MenuPoint[UserChoose].Command)
            {
            case    CLEARSECURITYCODE:                              /* 解锁清除函数功能 */
                ClearSecurityCodeInterface(AreaCodeSel);
                break;
            case    SHOWVERSIONSELECT:                              /* 显示版本功能 */
                GetVersionScreen();
                ShowVersionInterface();
                break;
            case    RTC_TIME_SET:                                           /* 设置当前RTC时间 */
                UserSetRtcTime();
                return;
            case    RTC_TIME_VIWE:                                      /* 显示当前RTC时间 */
                ShowRtcTime();
                break;

            }

//-------------------------------  开始判断command  ---------------------------------------------
            switch (MenuPoint[UserChoose].Command)
            {
            /********************************       烧录      ********************************/

            //NPG83_K_AS_71K
            case    BURPROGRAM_NPG83_K_AS_71K:
                BurnInterface(NPG83_K_AS_71K, BURN_NPG83_K_AS_71K, AreaCodeSel);
                break;

