        else if (KeyPressed == Key_Esc)          /* 退出底层用户界面，然后返回显示目录 */
        {
            DisplayStart = UserChoose;
            DisplayEnd = UserChoose + 6;
            if (DisplayEnd > MaxItems)
            {
                DisplayEnd = MaxItems;
                if (MaxItems >= 6)
                {
                    DisplayStart = MaxItems - 6;
                }
                else
                {
                    DisplayStart = 0;
                }
            }
            break;
        }
